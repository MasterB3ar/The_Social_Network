# Local development example. Copy to .env for local use.
NODE_ENV=development
PORT=3000

# Leave DATA_DIR unset for local development unless you know what you are doing.
# By default, TSN stores the live database outside the project folder:
#   Mac/Linux: ~/.tsn-social-network/db.json
# This prevents accounts/posts/messages from being wiped when you replace the project folder.
# DATA_DIR=/Users/yourname/.tsn-social-network

# Optional backup folder. Defaults to DATA_DIR/backups.
# TSN_BACKUP_DIR=/Users/yourname/.tsn-social-network/backups

# Required secrets. Keep both values private.
# TSN_DATA_ENCRYPTION_KEY controls encrypted profiles, posts, comments, private messages, and room messages.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
TSN_DATA_ENCRYPTION_KEY=change-this-to-a-different-long-random-secret-at-least-32-characters

# Simple local testing: plain demo/admin setup passwords still work.
# For better security, use the *_PASSWORD_HASH variables below instead.
TSN_DEMO_PASSWORD=TSN-Demo!9vK2p-Q8rM
TSN_ADMIN_SETUP_PASSWORD=TSN-Admin!ChangeMe-2026

# Server-side content filter. Enabled by default.
# Add extra blocked words/phrases as a comma-separated list.
TSN_CONTENT_FILTER_ENABLED=true
TSN_BLOCKED_WORDS=

# More secure option: generate bcrypt hashes and use these instead of the plain password variables.
# Command: npm run hash-secret -- "your-secret-password"
# TSN_DEMO_PASSWORD_HASH=
# TSN_ADMIN_SETUP_PASSWORD_HASH=
