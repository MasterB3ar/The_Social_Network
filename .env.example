# Local development example. Copy to .env for local use.
NODE_ENV=development
PORT=3000
DATA_DIR=./data

# Required secrets. Keep both values private.
# TSN_DATA_ENCRYPTION_KEY controls encrypted profiles, posts, comments, messages, and layer posts.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
TSN_DATA_ENCRYPTION_KEY=change-this-to-a-different-long-random-secret-at-least-32-characters

# Simple local testing: plain demo/layer passwords still work.
# For better security, use the *_PASSWORD_HASH variables below instead.
TSN_DEMO_PASSWORD=TSN-Demo!9vK2p-Q8rM
TSN_LAYER_1_PASSWORD=TSN-Layer1!8qN4-vZ2m-R7tP
TSN_LAYER_2_PASSWORD=TSN-Layer2!5xC9-mH6a-B3yL
TSN_LAYER_3_PASSWORD=TSN-Layer3!2pW7-kD8s-N4rX

# More secure option: generate bcrypt hashes and use these instead of the plain password variables.
# Command: npm run hash-secret -- "your-secret-password"
# TSN_DEMO_PASSWORD_HASH=
# TSN_LAYER_1_PASSWORD_HASH=
# TSN_LAYER_2_PASSWORD_HASH=
# TSN_LAYER_3_PASSWORD_HASH=
