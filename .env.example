# Lokal udvikling. Kopiér til .env, hvis du vil køre TSN lokalt.
NODE_ENV=development
PORT=3000

# MongoDB-lagring. Anbefales, hvis brugere/beskeder skal overleve updates/redeploys.
# Lad den være tom for lokal JSON-lagring, eller indsæt en MongoDB Atlas connection string.
# Eksempel: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=tsn
MONGODB_STATE_COLLECTION=app_state
MONGODB_STATE_ID=main

# Lokal JSON fallback. Hvis MONGODB_URI er tom, gemmer TSN data uden for projektmappen.
#   Mac/Linux: ~/.tsn-social-network/db.json
# DATA_DIR=/Users/yourname/.tsn-social-network

# Valgfri backup-mappe.
# TSN_BACKUP_DIR=/Users/yourname/.tsn-social-network/backups

# Påkrævede secrets. Hold dem private.
# VIGTIGT: behold den samme TSN_DATA_ENCRYPTION_KEY, når du opdaterer TSN.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
TSN_DATA_ENCRYPTION_KEY=change-this-to-a-different-long-random-secret-at-least-32-characters
TSN_OLD_DATA_ENCRYPTION_KEYS=

# Simpel lokal admin-test.
TSN_ADMIN_SETUP_PASSWORD=TSN-Admin!ChangeMe-2026

# Server-side indholdsfilter. Slået til som standard.
TSN_CONTENT_FILTER_ENABLED=true
TSN_BLOCKED_WORDS=



# Valgfri keep-awake ping target.
# Eksempel: https://your-tsn-site.onrender.com/api/ping
TSN_PING_URL=

# Mere sikker løsning: lav bcrypt hashes og brug disse i stedet.
# Kommando: npm run hash-secret -- "your-secret-password"
# TSN_ADMIN_SETUP_PASSWORD_HASH=
