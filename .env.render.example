# Use these in Render Environment Variables.
NODE_ENV=production
NODE_VERSION=24.14.1

# MongoDB Atlas connection string. This is the most important variable for keeping data.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tsn
MONGODB_STATE_COLLECTION=app_state
MONGODB_STATE_ID=main

# Generate both. Do not use the same value for both.
# IMPORTANT: do not change TSN_DATA_ENCRYPTION_KEY after real users/messages exist.
JWT_SECRET=<generate-a-long-random-secret>
TSN_DATA_ENCRYPTION_KEY=<generate-a-different-long-random-secret>
TSN_OLD_DATA_ENCRYPTION_KEYS=

# Admin setup. Easiest option:
TSN_ADMIN_SETUP_PASSWORD=<your-admin-setup-password>

# More secure option for demo/admin passwords:
# npm run hash-secret -- "your-secret-password"
TSN_DEMO_PASSWORD_HASH=<bcrypt-hash-for-demo-password>
# TSN_ADMIN_SETUP_PASSWORD_HASH=<bcrypt-hash-for-admin-setup-password>

# Server-side content filter. Enabled by default.
TSN_CONTENT_FILTER_ENABLED=true
TSN_BLOCKED_WORDS=

# Optional for external cron monitors.
TSN_PING_URL=https://your-tsn-site.onrender.com/api/ping
