# Use these in Render Environment Variables.
NODE_ENV=production
NODE_VERSION=24.14.1

# Free testing config. Data can reset after deploy/restart.
DATA_DIR=/tmp/tsn-data

# Paid persistent disk config. Use this if you attach a disk at /var/data.
# DATA_DIR=/var/data

# Generate both. Do not use the same value for both.
# TSN_DATA_ENCRYPTION_KEY controls encrypted profiles, posts, comments, messages, and layer posts.
JWT_SECRET=<generate-a-long-random-secret>
TSN_DATA_ENCRYPTION_KEY=<generate-a-different-long-random-secret>

# Best option for Render: store hashes, not real layer/demo passwords.
# Generate each hash locally with:
# npm run hash-secret -- "your-secret-password"
TSN_DEMO_PASSWORD_HASH=<bcrypt-hash-for-demo-password>
TSN_LAYER_1_PASSWORD_HASH=<bcrypt-hash-for-layer-1-password>
TSN_LAYER_2_PASSWORD_HASH=<bcrypt-hash-for-layer-2-password>
TSN_LAYER_3_PASSWORD_HASH=<bcrypt-hash-for-layer-3-password>

# Optional fallback. Use only if you do not want to generate hashes.
# TSN_DEMO_PASSWORD=<strong demo password>
# TSN_LAYER_1_PASSWORD=<strong layer 1 password>
# TSN_LAYER_2_PASSWORD=<strong layer 2 password>
# TSN_LAYER_3_PASSWORD=<strong layer 3 password>
