# Brug disse i Render Environment Variables.
NODE_ENV=production
NODE_VERSION=20.12.2

# MongoDB Atlas connection string. Den vigtigste variable for at bevare data.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tsn
MONGODB_STATE_COLLECTION=app_state
MONGODB_STATE_ID=main

# Lav begge secrets. Brug ikke samme værdi til begge.
# VIGTIGT: skift ikke TSN_DATA_ENCRYPTION_KEY efter rigtige brugere/beskeder findes.
JWT_SECRET=<generate-a-long-random-secret>
TSN_DATA_ENCRYPTION_KEY=<generate-a-different-long-random-secret>
TSN_OLD_DATA_ENCRYPTION_KEYS=

# Admin setup.
TSN_ADMIN_SETUP_PASSWORD=<your-admin-setup-password>

# Mere sikker løsning til admin password:
# npm run hash-secret -- "your-secret-password"
# TSN_ADMIN_SETUP_PASSWORD_HASH=<bcrypt-hash-for-admin-setup-password>

# Server-side indholdsfilter.
TSN_CONTENT_FILTER_ENABLED=true
TSN_BLOCKED_WORDS=

# Anti-spam og midlertidig mute. Kan justeres uden kodeændring.
TSN_ANTI_SPAM_ENABLED=true
TSN_MESSAGE_COOLDOWN_MS=1500
TSN_DUPLICATE_MESSAGE_WINDOW_MS=120000
TSN_MAX_DUPLICATES_PER_WINDOW=3
TSN_SPAM_WINDOW_MS=60000
TSN_MAX_MESSAGES_PER_SPAM_WINDOW=20
TSN_AUTO_MUTE_AFTER_WARNINGS=5
TSN_AUTO_MUTE_MINUTES=10
TSN_DEFAULT_ADMIN_MUTE_MINUTES=10



# Valgfri til eksterne cron monitors.
TSN_PING_URL=https://your-tsn-site.onrender.com/api/ping

# TSN V1.4.0 growth features.
TSN_MAX_CUSTOM_BADGES_PER_USER=6
TSN_NOTIFICATION_LIMIT=3000
TSN_WARNINGS_LIMIT=1000

# TSN V1.5.0 Activity + Events
TSN_ACTIVITY_FEED_LIMIT=150
TSN_EVENTS_LIMIT=80
TSN_POLLS_LIMIT=60
TSN_LEADERBOARD_LIMIT=20
TSN_XP_DAILY_LOGIN=20
TSN_XP_GLOBAL_MESSAGE=3
TSN_XP_PRIVATE_MESSAGE=2
TSN_XP_REACTION_RECEIVED=1
TSN_XP_FRIEND_ACCEPTED=10
TSN_XP_EVENT_JOIN=8
TSN_XP_POLL_VOTE=4

# Picture/GIF messages
# Picture/GIF messages
# Random user uploads are blocked. Users choose from TSN's built-in library or approved website search results.
TSN_IMAGE_MAX_BYTES=2097152

# Website media search. Tenor is for GIFs; Pixabay is for photos.
# You need API keys before external search returns results.
TSN_MEDIA_WEB_SEARCH_ENABLED=true
TSN_MEDIA_WEB_PROVIDERS=tenor,pixabay
TSN_MEDIA_WEB_SEARCH_LIMIT=18
TSN_MEDIA_WEB_CACHE_TTL_MS=900000
TSN_TENOR_API_KEY=
TSN_TENOR_CLIENT_KEY=tsn
TSN_TENOR_CONTENT_FILTER=high
TSN_TENOR_LOCALE=da_DK
TSN_PIXABAY_API_KEY=
