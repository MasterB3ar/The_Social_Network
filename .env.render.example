# Brug disse i Render Environment Variables.
NODE_ENV=production
NODE_VERSION=20.12.2

# MongoDB Atlas connection string. Den vigtigste variable for at bevare data.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tsn
MONGODB_STATE_COLLECTION=app_state
MONGODB_STATE_ID=main

# Lav begge secrets. Brug ikke samme værdi til begge.
# VIGTIGT: skift ikke TSN_DATA_ENCRYPTION_KEY efter rigtige brugere/beskeder findes.
JWT_SECRET=<generate-a-long-random-secret>
TSN_DATA_ENCRYPTION_KEY=<generate-a-different-long-random-secret>
TSN_OLD_DATA_ENCRYPTION_KEYS=

# Admin setup.
TSN_ADMIN_SETUP_PASSWORD=<your-admin-setup-password>

# Mere sikker løsning til admin password:
# npm run hash-secret -- "your-secret-password"
# TSN_ADMIN_SETUP_PASSWORD_HASH=<bcrypt-hash-for-admin-setup-password>

# Server-side indholdsfilter.
TSN_CONTENT_FILTER_ENABLED=true
TSN_BLOCKED_WORDS=


# TSNM Market / cosmetic store. Normal TSN only spends TSNM; TSNM is earned in TSN-S / TSN-Stock.
# Point this at the same MongoDB wallet database used by TSN-S.
TSNS_MONGODB_URI=
TSNS_MONGODB_DATABASE=tsn_stock
TSNS_WALLET_COLLECTION=tsnMoneyWallets

# Valgfri til eksterne cron monitors.
TSN_PING_URL=https://your-tsn-site.onrender.com/api/ping
