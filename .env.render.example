# Use these in Render Environment Variables.
NODE_ENV=production
NODE_VERSION=24.14.1

# Persistent Render disk config. Attach a disk mounted at /var/data.
DATA_DIR=/var/data

# Optional backup folder. Defaults to DATA_DIR/backups.
# TSN_BACKUP_DIR=/var/data/backups

# Generate both. Do not use the same value for both.
# TSN_DATA_ENCRYPTION_KEY controls encrypted profiles, posts, comments, private messages, and room messages.
# IMPORTANT: do not change TSN_DATA_ENCRYPTION_KEY after real users/messages exist.
JWT_SECRET=<generate-a-long-random-secret>
TSN_DATA_ENCRYPTION_KEY=<generate-a-different-long-random-secret>

# Best option for Render: store hashes, not real demo/admin passwords.
# Generate each hash locally with:
# npm run hash-secret -- "your-secret-password"
TSN_DEMO_PASSWORD_HASH=<bcrypt-hash-for-demo-password>
TSN_ADMIN_SETUP_PASSWORD_HASH=<bcrypt-hash-for-admin-setup-password>

# Optional fallback. Use only if you do not want to generate hashes.
# TSN_DEMO_PASSWORD=<strong demo password>
# TSN_ADMIN_SETUP_PASSWORD=<strong admin setup password>

# Server-side content filter. Enabled by default.
# Add extra blocked words/phrases as a comma-separated list.
TSN_CONTENT_FILTER_ENABLED=true
TSN_BLOCKED_WORDS=
